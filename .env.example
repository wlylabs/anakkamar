# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client — bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# Midtrans — Pengaturan → Akses Integrasi. Use the Sandbox Server Key until
# launch. We call the Core API directly (custom QRIS/GoPay UI, not Snap), so
# only the Server Key is needed — no client key, nothing public.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Absolute site URL, used for the Supabase magic-link redirect.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The one account allowed to approve/reject manual DANA transfers at
# /admin/plus. Must match the email that account signs in with. Server-only.
ADMIN_EMAIL=

# Journal reflection (optional). Each user pastes their own free Groq/Gemini
# key in Profile — see "Journal AI" below — so these are NOT required. Set
# them only if you want a shared server-side default for users who haven't
# added their own key yet.
GROQ_API_KEY=
GEMINI_API_KEY=
