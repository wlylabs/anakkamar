# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client — bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# Midtrans — Pengaturan → Akses Integrasi. Use the Sandbox keys until launch.
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
# Keep these two in sync — the server one gates the API calls, the public
# one only picks which snap.js host the browser loads.
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# Absolute site URL, used for the Supabase magic-link redirect.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
